#
# 01 Glove receiver: its serial port, and the USB node libpandora writes to
# switch the CH343 bridge's hardware flow control on.

# nRF receiver
SUBSYSTEM=="tty", ATTRS{idVendor}=="1915", ATTRS{idProduct}=="5c72", MODE="0666", TAG+="uaccess"
# CH343P bridge (both product ids)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1a86", ATTR{idProduct}=="55d4", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1a86", ATTR{idProduct}=="55d3", MODE="0666", TAG+="uaccess"
